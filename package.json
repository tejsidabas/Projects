{
  "name": "sahayata-household-help",
  "version": "1.0.0",
  "private": true,
  "description": "Sahayata smart household help booking system",
  "scripts": {
    "dev": "concurrently -k \"npm run server\" \"npm run client\"",
    "server": "npm --prefix server run dev",
    "client": "npm --prefix client run dev -- --host 0.0.0.0",
    "build": "npm --prefix client run build",
    "start": "npm --prefix server start",
    "install:all": "npm install --prefix client && npm install --prefix server"
  },
  "devDependencies": {
    "concurrently": "^9.1.2"
  }
}
